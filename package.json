{
  "name": "madarij-platform",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "^20.19.0 || >=22.13.0"
  },
  "scripts": {
    "dev": "vite --host :: --port 3000",
    "api": "node server/index.js",
    "worker:notifications": "node server/workers/notificationPushWorker.js",
    "worker:nazem": "node server/workers/nazemSyncWorker.js",
    "dev:full": "concurrently \"npm run api\" \"npm run dev\" \"npm run worker:nazem\"",
    "setup:nazem": "playwright install chromium",
    "verify:recitation:mysql": "node scripts/verify-recitation-mysql.mjs",
    "verify:nazem:live": "node scripts/verify-nazem-live.mjs",
    "build": "vite build --mode madarij --outDir dist/madarij --emptyOutDir",
    "build:madarij": "npm run build",
    "build:mobile": "vite build --mode mobile --outDir dist/madarij-mobile --emptyOutDir",
    "native:sync": "npm run build:mobile && cap sync",
    "native:android": "npm run build:mobile && cap sync android && node scripts/remove-native-download-artifacts.mjs android",
    "native:ios": "npm run build:mobile && cap sync ios && node scripts/remove-native-download-artifacts.mjs ios",
    "release:ios:prepare": "npm run check && npm run build:mobile && cap sync ios && node scripts/remove-native-download-artifacts.mjs ios",
    "native:open:android": "cap open android",
    "native:open:ios": "cap open ios",
    "generate:quran-layout": "node scripts/generate-quran-line-layout.mjs",
    "generate:quran-offline": "node scripts/generate-offline-mushaf.mjs",
    "generate:brand-assets": "node scripts/generate-rawasi-brand-assets.mjs",
    "audit:launch": "node scripts/isolated-launch-audit.mjs",
    "audit:notifications": "node scripts/isolated-launch-audit.mjs",
    "preview": "vite preview --host :: --port 3000",
    "start": "vite preview --outDir dist/madarij --host :: --port 3000",
    "lint": "eslint . --quiet",
    "test": "node --test tests/*.test.js",
    "audit": "npm audit --audit-level=moderate",
    "compliance": "node scripts/check-agent-compliance.mjs",
    "verify:quick": "npm run compliance && npm run lint && npm test",
    "verify": "npm run verify:quick && npm run audit && npm run build:madarij",
    "check": "npm run verify"
  },
  "dependencies": {
    "@aparajita/capacitor-secure-storage": "^8.0.0",
    "@aws-sdk/client-s3": "^3.1106.0",
    "@capacitor-community/sqlite": "^8.1.1",
    "@capacitor/android": "^8.4.2",
    "@capacitor/app": "^8.0.0",
    "@capacitor/background-runner": "^3.0.0",
    "@capacitor/core": "^8.4.2",
    "@capacitor/ios": "^8.4.2",
    "@capacitor/network": "^8.0.1",
    "@capacitor/push-notifications": "^8.1.2",
    "@capacitor/splash-screen": "^8.0.0",
    "@capacitor/status-bar": "^8.0.0",
    "@radix-ui/react-dialog": "^1.0.5",
    "@radix-ui/react-label": "^2.0.2",
    "@radix-ui/react-popover": "^1.1.17",
    "@radix-ui/react-select": "^2.3.1",
    "@radix-ui/react-slot": "^1.0.2",
    "@radix-ui/react-toast": "^1.1.5",
    "@radix-ui/react-tooltip": "^1.2.10",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.0.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "framer-motion": "^10.16.4",
    "livekit-client": "^2.20.1",
    "livekit-server-sdk": "^2.17.0",
    "lucide-react": "^0.285.0",
    "mysql2": "^3.24.4",
    "pdfkit": "^0.19.1",
    "playwright": "^1.62.1",
    "qrcode": "^1.5.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-helmet": "^6.1.0",
    "read-excel-file": "^9.2.0",
    "sharp": "^0.35.4",
    "tailwind-merge": "^1.1.4",
    "tailwindcss-animate": "^1.0.7",
    "whatsapp-web.js": "^1.34.7",
    "wouter": "^3.10.0"
  },
  "overrides": {
    "archiver": "8.0.0",
    "esbuild": "^0.28.1",
    "js-yaml": "4.3.1",
    "nanoid": "3.3.18",
    "puppeteer": "25.7.0",
    "puppeteer-core": "25.7.0",
    "unzipper": "0.12.5",
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.4.2",
    "@eslint/js": "^10.0.1",
    "@types/node": "^20.8.3",
    "@types/react": "^18.2.15",
    "@types/react-dom": "^18.2.7",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.4.16",
    "concurrently": "^9.2.1",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.8.0",
    "postcss": "^8.5.23",
    "tailwindcss": "^3.3.3",
    "vite": "^7.3.1"
  }
}
