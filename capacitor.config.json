{
  "appId": "sa.madarij.app",
  "appName": "الحبيب ماب",
  "webDir": "dist/madarij-mobile",
  "backgroundColor": "#001F29",
  "loggingBehavior": "production",
  "zoomEnabled": false,
  "android": {
    "allowMixedContent": false,
    "webContentsDebuggingEnabled": false
  },
  "ios": {
    "contentInset": "never",
    "preferredContentMode": "mobile",
    "allowsLinkPreview": false,
    "webContentsDebuggingEnabled": false
  },
  "server": {
    "hostname": "localhost",
    "androidScheme": "https",
    "cleartext": false
  },
  "plugins": {
    "PushNotifications": { "presentationOptions": ["sound", "banner", "list"] },
    "SystemBars": {
      "insetsHandling": "css",
      "style": "DARK"
    },
    "SplashScreen": {
      "launchShowDuration": 0,
      "launchAutoHide": true,
      "backgroundColor": "#001F29",
      "showSpinner": false
    },
    "StatusBar": {
      "overlaysWebView": false,
      "style": "DARK",
      "backgroundColor": "#001F29"
    },
    "CapacitorSQLite": {
      "iosDatabaseLocation": "Library/CapacitorDatabase",
      "iosIsEncryption": true,
      "iosKeychainPrefix": "sa.madarij.app.offline",
      "androidIsEncryption": true
    },
    "BackgroundRunner": {
      "label": "sa.madarij.app.offline-recitation",
      "src": "runners/offline-recitation.js",
      "event": "madarijOfflineRecitationSync",
      "repeat": true,
      "interval": 15,
      "autoStart": true
    }
  }
}
