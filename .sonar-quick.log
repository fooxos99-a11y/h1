      const [fromBoundary, toBoundary] = await Promise.all([
        getQcfVersePageBoundary(`${Number(task.fromSurah || 0)}:${Number(task.fromAyah || 0)}`),
        getQcfVersePageBoundary(`${endSurah}:${endAyah}`),
      ]);
      return getInclusiveQcfPages(
