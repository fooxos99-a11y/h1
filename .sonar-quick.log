      try {
        const name = String(req.body.name || '').trim();
        if (!name) {
          return res.status(422).json({ message: 'اسم الحلقة مطلوب.' });
        }
    
        const [result] = await db().query(
          `
          INSERT INTO committees (name)
          VALUES (?)
          `,
