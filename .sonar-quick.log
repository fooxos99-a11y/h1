                  }
                  return normalizeRepeatCount(task.track === 'mastery' ? settings.masteryRepeatCount : settings.memorizationRepeatCount, 1);
                };
                const _resolveExpectedListeningCount5 = () => {
                  if (task.nazemManaged) {
